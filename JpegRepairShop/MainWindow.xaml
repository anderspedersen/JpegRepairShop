<Window x:Class="JpegRepairShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:JpegRepairShop.Controls"
        xmlns:vm="clr-namespace:JpegRepairShop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}" Height="860" Width="1400"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Toolbar buttons with an icon from the Windows icon font (Fluent on Windows 11, MDL2 on Windows 10).
             Put the glyph in Tag and the label in Content. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Icon-only toolbar button: the glyph is the Content. -->
        <Style x:Key="IconOnlyButton" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="SpinBox" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpinButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Delay" Value="350" />
            <Setter Property="Interval" Value="70" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A0078D7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#400078D7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Insert" Command="{Binding InsertBlankCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveMcuCommand}" />
        <KeyBinding Key="F" Command="{Binding FixColorsCommand}" />
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding FixAllCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource IconButton}" Tag="&#xE8E5;" Content="Open…" Command="{Binding OpenFileCommand}" ToolTip="Open a JPEG (Ctrl+O)" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE72C;" Content="Reload" Command="{Binding ReloadCommand}" ToolTip="Reload from disk, discarding repairs (F5)" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE792;" Content="Save as…" Command="{Binding SaveAsCommand}" ToolTip="Write the repaired image as a new file (Ctrl+S)" />
                <Separator />
                <Button Style="{StaticResource IconOnlyButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Undo" />
                <Button Style="{StaticResource IconOnlyButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Redo" />
                <Separator />
                <CheckBox Content="MCU grid" IsChecked="{Binding ShowGrid}" Margin="2,0" />
                <CheckBox Content="Highlight problems" IsChecked="{Binding HighlightProblems}" Margin="8,0,2,0"
                          ToolTip="Red = invalid data in this MCU, faint red with cross = not decoded (data ran out), blue = blank MCU you inserted" />
                <Separator />
                <Button Style="{StaticResource IconButton}" Tag="&#xE9A6;" Content="Fit" Click="OnFitClick" ToolTip="Fit image to window (Ctrl+0)" />
                <Button Style="{StaticResource IconButton}" Tag="&#xE71E;" Content="1:1" Click="OnActualSizeClick" ToolTip="Actual size (Ctrl+1)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Summary}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Zoom, ElementName=ImageView, StringFormat='Zoom {0:P0}'}" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="330" Padding="10,0,10,10" BorderBrush="#22000000" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Under cursor" Style="{StaticResource Heading}" />
                    <controls:McuPreview Height="130" Document="{Binding Document}" Revision="{Binding Revision}" McuIndex="{Binding HoverMcu}" />
                    <TextBlock Text="{Binding HoverInfo}" Style="{StaticResource Info}" />

                    <TextBlock Text="Selected (click, or arrow keys)" Style="{StaticResource Heading}" />
                    <controls:McuPreview Height="130" Document="{Binding Document}" Revision="{Binding Revision}" McuIndex="{Binding SelectedMcu}" />
                    <TextBlock Text="{Binding SelectedInfo}" Style="{StaticResource Info}" />

                    <TextBlock Text="Repair whole picture" Style="{StaticResource Heading}" />
                    <Button Content="Fix all…" Command="{Binding FixAllCommand}" Padding="2,3"
                            ToolTip="Find and fix misaligned MCUs and colour shifts in the whole picture, worst first, until nothing more is found (Ctrl+Shift+A). Shows progress and can be stopped; every fix is its own undo step." />

                    <TextBlock Text="Repair at selected MCU" Style="{StaticResource Heading}" />
                    <UniformGrid Columns="3">
                        <Button Content="Insert blank" Command="{Binding InsertBlankCommand}" Margin="0,0,3,0" Padding="2,3"
                                ToolTip="Insert a grey MCU here; everything after it moves right (Insert). Use when data was lost." />
                        <Button Content="Remove" Command="{Binding RemoveMcuCommand}" Margin="3,0,3,0" Padding="2,3"
                                ToolTip="Remove this MCU; everything after it moves left (Delete). Use on garbage MCUs." />
                        <Button Content="Fix colours" Command="{Binding FixColorsCommand}" Margin="3,0,0,0" Padding="2,3"
                                ToolTip="Match colours from here on to the MCU row above (F). Select the first MCU with wrong colours." />
                    </UniformGrid>
                    <TextBlock Text="DC from selected MCU onwards" Margin="0,10,0,0" Foreground="Gray" />
                    <TextBlock Text="hold a button to speed up · scroll over a value (Shift = ×10)" Margin="0,0,0,4" Foreground="#999" FontSize="10.5" />
                    <ItemsControl ItemsSource="{Binding DcChannels}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Style="{StaticResource SpinBox}" MouseWheel="OnDcWheel"
                                            ToolTip="DC value per 8×8 block of this channel. Changing it shifts this MCU and every MCU after it.">
                                        <DockPanel>
                                            <controls:AcceleratingRepeatButton DockPanel.Dock="Left" Content="−" Command="{Binding DecreaseCommand}" Style="{StaticResource SpinButton}" />
                                            <controls:AcceleratingRepeatButton DockPanel.Dock="Right" Content="+" Command="{Binding IncreaseCommand}" Style="{StaticResource SpinButton}" />
                                            <TextBlock Text="{Binding Values}" FontFamily="Consolas" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Change}" Foreground="#0063B1" FontFamily="Consolas"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="Change from the value originally decoded" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Problems" Style="{StaticResource Heading}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Location}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Background="#202024">
            <controls:JpegCanvas x:Name="ImageView"
                                 Document="{Binding Document}"
                                 Revision="{Binding Revision}"
                                 SelectedMcu="{Binding SelectedMcu}"
                                 HoverMcu="{Binding HoverMcu}"
                                 ShowGrid="{Binding ShowGrid}"
                                 HighlightProblems="{Binding HighlightProblems}" />
            <controls:McuOverlay Target="{Binding ElementName=ImageView}" />

            <TextBlock Text="Open a JPEG file, or drop one here."
                       Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}"
                       Foreground="#99FFFFFF" FontSize="16" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        MaxWidth="620" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF8A80" FontSize="16"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Border Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,20,0,0" Padding="18,14" CornerRadius="6" Background="#2C2C31" BorderBrush="#45454D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorDetail}" Foreground="#E6E6E6" FontSize="13" LineHeight="19" TextWrapping="Wrap" />
                        <Button Content="Borrow header from other picture(s)…" Command="{Binding BorrowHeaderCommand}"
                                Visibility="{Binding CanBorrowHeader, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,6" FontSize="13" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding BusyText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                       Foreground="White" FontSize="16" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
