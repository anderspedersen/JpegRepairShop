<Window x:Class="JpegRepairShop.FixAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix all" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="OnClosing">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="Searching for damage…" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar Height="6" Margin="0,10,0,10" IsIndeterminate="True" x:Name="Progress" />
        <TextBlock x:Name="CountText" Text="No fixes applied yet." />
        <ListBox x:Name="Log" Height="160" Margin="0,8,0,0" FontSize="11.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Search:" Margin="0,0,8,0" VerticalAlignment="Center" />
            <RadioButton x:Name="FastRadio" GroupName="Speed" Content="Fast" Margin="0,0,12,0" Checked="OnSpeedChecked"
                         ToolTip="Good enough for most pictures." />
            <RadioButton x:Name="SlowRadio" GroupName="Speed" Content="Slow" Margin="0,0,12,0" Checked="OnSpeedChecked"
                         ToolTip="Tries more possibilities. Takes several times longer." />
            <RadioButton x:Name="VerySlowRadio" GroupName="Speed" Content="Very slow" Checked="OnSpeedChecked"
                         ToolTip="Tries even more possibilities. Can take a long time on large pictures." />
        </StackPanel>
        <TextBlock Text="Each fix is a separate undo step (Ctrl+Z)." Foreground="Gray" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PauseButton" Content="Pause" MinWidth="80" Padding="8,3" Margin="0,0,8,0" Click="OnPauseClick"
                    ToolTip="Pause at once, to look at the picture so far (zoom and pan work while paused)." />
            <Button x:Name="StopButton" Content="Stop" MinWidth="80" Padding="8,3" IsCancel="True" Click="OnStopClick" />
        </StackPanel>
    </StackPanel>
</Window>
