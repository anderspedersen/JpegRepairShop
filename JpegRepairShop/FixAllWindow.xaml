<Window x:Class="JpegRepairShop.FixAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix all" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="OnClosing">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="Searching for damage…" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar Height="6" Margin="0,10,0,10" IsIndeterminate="True" x:Name="Progress" />
        <TextBlock x:Name="CountText" Text="No fixes applied yet." />
        <ListBox x:Name="Log" Height="160" Margin="0,8,0,0" FontSize="11.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox x:Name="StripesCheck" Margin="0,10,0,0" Checked="OnStripesChecked"
                  Content="Continue with fine-tuning the stretches between damaged areas"
                  ToolTip="Optional last step: short stretches between damaged areas are moved back into place and/or get their colours corrected. Can be changed while the first part runs." />
        <TextBlock Margin="20,2,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Can take a long time on badly damaged pictures, and may now and then make a spot worse instead of better." />
        <TextBlock Text="Each fix is a separate undo step (Ctrl+Z)." Foreground="Gray" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="StripesButton" Content="Fine-tune" MinWidth="80" Padding="8,3" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OnStripesClick"
                    ToolTip="Go on with the optional last step: fine-tune the stretches between damaged areas." />
            <Button x:Name="PauseButton" Content="Pause" MinWidth="80" Padding="8,3" Margin="0,0,8,0" Click="OnPauseClick"
                    ToolTip="Pause at once, to look at the picture so far (zoom and pan work while paused)." />
            <Button x:Name="StopButton" Content="Stop" MinWidth="80" Padding="8,3" IsCancel="True" Click="OnStopClick" />
        </StackPanel>
    </StackPanel>
</Window>
