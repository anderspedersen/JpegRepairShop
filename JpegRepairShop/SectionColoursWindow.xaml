<Window x:Class="JpegRepairShop.SectionColoursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fix section colours" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                   Text="The section's colours are matched to the good MCUs in the rows above it." />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Rows to look upwards:" VerticalAlignment="Center" />
            <TextBox x:Name="RowsBox" Width="56" Margin="8,0,0,0" Padding="2" VerticalContentAlignment="Center"
                     TextChanged="OnRowsChanged" PreviewKeyDown="OnRowsKeyDown" />
            <TextBlock x:Name="RangeText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <TextBlock Text="Fewer rows: closer to the section. More rows: more MCUs to compare (↑/↓ change the number)."
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Fix" MinWidth="80" Padding="8,3" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" MinWidth="80" Padding="8,3" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
